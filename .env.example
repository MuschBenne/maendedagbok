# Miljövariabler. Kopiera till .env.local och fyll i. .env.local checkas aldrig in.

# Vilken databas appen använder:
#   mock  = i minnet, allt försvinner vid omstart. För att bygga gränssnittet innan SQL:en är klar.
#   mysql = riktig databas via DATABASE_URL.
DB_DRIVER=mock

# Appens databas. Specialtecken i lösenordet måste URL-kodas (t.ex. blir @ %40).
# Lokalt:      mysql://root:LOSENORD@localhost:3306/maendedagbok
# TiDB Cloud:  mysql://ANVANDARE:LOSENORD@gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/maendedagbok
DATABASE_URL=

# Testdatabas för `npm run test:db`. Den töms och byggs om från db/schema.sql vid varje körning,
# så använd aldrig samma databas som ovan. Namnet måste sluta på _test.
DATABASE_URL_TEST=mysql://root:LOSENORD@localhost:3306/maendedagbok_test
